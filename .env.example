# Local Docker Compose only. Generate three DIFFERENT random passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
OPIGNO_ADMIN_PASSWORD=
OPIGNO_ADMIN_USERNAME=admin
OPIGNO_ADMIN_EMAIL=admin@example.com
OPIGNO_SITE_NAME=Opigno LMS
LOCAL_PORT=8080

# Resend placeholders: supply a sending API key and a verified-domain sender.
# Leave both blank to run without outgoing email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Opigno LMS
