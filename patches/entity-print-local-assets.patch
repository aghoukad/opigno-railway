   /**
+   * Resolve same-origin images and stylesheets locally without HTTP requests.
+   */
+  private function localizeAssets(string $html): string {
+    $document = new \DOMDocument();
+    $previous = libxml_use_internal_errors(TRUE);
+    try {
+      if (!$document->loadHTML('<?xml encoding="UTF-8">' . $html, LIBXML_NONET)) {
+        throw new PrintEngineException('Unable to parse certificate HTML.');
+      }
+      // Remove the encoding hint before Dompdf's HTML5 parser reads the HTML.
+      foreach (iterator_to_array($document->childNodes) as $node) {
+        if ($node->nodeType === XML_PI_NODE) {
+          $document->removeChild($node);
+        }
+      }
+      $xpath = new \DOMXPath($document);
+      foreach ($xpath->query('//base') as $base) {
+        $base->parentNode->removeChild($base);
+      }
+      $origin = $this->request->getSchemeAndHttpHost();
+      foreach ($xpath->query('//img/@src | //link[@rel="stylesheet"]/@href') as $attribute) {
+        if (str_starts_with($attribute->value, $origin . '/')) {
+          $attribute->value = substr($attribute->value, strlen($origin));
+        }
+      }
+      return $document->saveHTML();
+    }
+    finally {
+      libxml_clear_errors();
+      libxml_use_internal_errors($previous);
+    }
+  }
+
