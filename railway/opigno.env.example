# Paste into the Opigno service's Variables > Raw Editor in the TEMPLATE editor.
# The database service must be named MySQL (case-sensitive).
MYSQLHOST=${{MySQL.RAILWAY_PRIVATE_DOMAIN}}
MYSQLPORT=3306
MYSQLDATABASE=${{MySQL.MYSQL_DATABASE}}
MYSQLUSER=${{MySQL.MYSQL_USER}}
MYSQLPASSWORD=${{MySQL.MYSQL_PASSWORD}}
OPIGNO_ADMIN_USERNAME=admin
OPIGNO_ADMIN_PASSWORD=${{secret(32)}}
OPIGNO_ADMIN_EMAIL=admin@example.com
OPIGNO_SITE_NAME=Opigno LMS
DRUPAL_HASH_SALT=${{secret(64)}}
PORT=8080
TRUST_REVERSE_PROXY=1
CRON_ENABLED=1
CRON_INTERVAL=300
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=900
