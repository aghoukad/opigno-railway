    "require": {
        "wikimedia/composer-merge-plugin": "2.0",
        "composer/installers": "*",
        "cweagans/composer-patches": "^1.7",
        "drupal/core-composer-scaffold": "^10.0",
        "opigno/opigno_lms": "3.2.7-patch1",
        "drush/drush": "^12.5",
        "h5p/h5p-editor": "1.25.0-patch1"
    },
    "config": {
        "sort-packages": false,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "wikimedia/composer-merge-plugin": true,
            "drupal/console-extend-plugin": true,
            "topfloor/composer-cleanup-vcs-dirs": true,
            "mglaman/composer-drupal-lenient": true
        }
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/libraries/ckeditor": [
                "type:drupal-library-ckeditor"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "opigno/opigno_lms": {
                "Use Drupal core CKEditor 5": "patches/profile-ckeditor5.patch"
            },
            "drupal/opigno_certificate": {
                "Migrate certificate configuration to CKEditor 5": "patches/certificate-ckeditor5.patch"
            },
            "drupal/opigno_module": {
                "Support PDF.js ES modules and current Twig": "patches/module-pdfjs-twig.patch"
            },
            "drupal/opigno_learning_path": {
                "Remove obsolete Twig spaceless filter": "patches/learning-path-twig.patch"
            },
            "drupal/pdf": {
                "Load PDF.js ES modules with Drupal behaviors": "patches/pdf-es-modules.patch"
            },
            "drupal/entity_print": {
                "Constrain Dompdf to local public assets": "patches/entity-print-local-assets.patch"
            },
            "drupal/h5p": {
                "Implement H5P Core 1.28 hub reset callback": "patches/h5p-core-128.patch"
            },
            "h5p/h5p-editor": {
                "Use the pinned H5P core 1.28 storage API": "patches/h5p-editor-core128.patch"
            }
        }
    }
}
